{
  "name": "signing-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Human-readable previews of EVM and Hyperliquid signing requests (Ethereum, Arbitrum, HyperEVM, HyperCore)",
  "keywords": [
    "wallet",
    "signing",
    "transaction-preview",
    "eip-1193",
    "eip-712",
    "eip-5792",
    "hyperliquid",
    "hypercore",
    "hyperevm",
    "cctp",
    "uniswap",
    "hyperlend",
    "kinetiq"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyrasz/signing-preview.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/lib/src/index.js",
  "types": "./dist/lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/src/index.d.ts",
      "default": "./dist/lib/src/index.js"
    },
    "./server": {
      "types": "./dist/lib/src/server.d.ts",
      "default": "./dist/lib/src/server.js"
    },
    "./interceptor": {
      "types": "./dist/lib/src/interceptor.d.ts",
      "default": "./dist/lib/src/interceptor.js"
    },
    "./fork": {
      "types": "./dist/lib/src/fork-simulator.d.ts",
      "default": "./dist/lib/src/fork-simulator.js"
    },
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "signing-preview": "dist/lib/src/cli.js"
  },
  "files": [
    "dist/lib",
    "dist/signing-preview.js",
    "dist/interceptor.js",
    "demo",
    "openapi.json"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "build:lib": "node -e \"require('fs').rmSync('dist/lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build:lib && npm run build",
    "start": "npm run build && node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:live": "NODE_USE_ENV_PROXY=1 node scripts/verify-live.ts",
    "check:package": "node scripts/check-package.ts",
    "coverage": "NODE_USE_ENV_PROXY=1 node scripts/coverage.ts",
    "build:probe": "node scripts/build-probe.ts"
  },
  "dependencies": {
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/evm": "10.1.3",
    "@ethereumjs/statemanager": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@msgpack/msgpack": "3.1.3",
    "viem": "2.57.6"
  },
  "devDependencies": {
    "@apidevtools/openapi-schemas": "2.1.0",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "solc": "0.8.37",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
